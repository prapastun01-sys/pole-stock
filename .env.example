# ===== Supabase (Project Settings > API) =====
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# service_role key: ใช้ฝั่งเซิร์ฟเวอร์เท่านั้น ห้ามใส่ NEXT_PUBLIC_ และห้ามเปิดเผย
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# ===== Google Apps Script Web App =====
GAS_URL=https://script.google.com/macros/s/AKfycb.../exec
GAS_SECRET=ตั้งรหัสลับยาวๆ_ให้ตรงกับใน_Apps_Script

# ===== รหัสผ่านเข้าใช้งานเว็บ (ทุกคนในทีมใช้ร่วมกัน) =====
APP_PASSCODE=ตั้งรหัสที่ต้องการ

# ===== (ไม่บังคับ) URL เว็บหลัง deploy ใช้แนบลิงก์ใน Telegram =====
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ===== (ไม่บังคับ) ชื่อหน่วยงาน แสดงหัวใบเบิก PDF =====
ORG_NAME=
